# Development example only. Replace placeholders before use; production uses a secret manager.
NODE_ENV=development
PORT=5001
CLIENT_ORIGIN=http://localhost:3000
# Optional comma-separated proxy IPs/CIDRs. Leave empty unless requests arrive through a known proxy.
TRUSTED_PROXY_IPS=
JWT_SECRET=replace_with_a_secure_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
SESSION_COOKIE_MAX_AGE_MS=604800000
MONITOR_TIMEOUT_MS=10000
MONITOR_CONCURRENCY=5
MONITOR_WORKER_ENABLED=true

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pulsewatch
DB_CONNECTION_LIMIT=10
# Optional for local MySQL; mandatory in production. Use a mounted CA certificate file.
# DB_SSL_CA_FILE=/path/to/mysql-ca.pem

BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=PulseWatch
SKIP_EMAIL=false
# Optional HTTPS webhook; alert payloads contain event metadata only.
# ALERT_WEBHOOK_URL=https://alerts.example.net/hooks/replace-me
