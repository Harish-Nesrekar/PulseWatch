{
  "name": "@pulsewatch/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import=tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
